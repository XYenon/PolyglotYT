#!/usr/bin/env bash
set -euo pipefail

# Install JDK 21, the Android SDK, and Gradle caches so a fresh orb can
# compile this Xposed module. Idempotent: safe to re-run on a warm snapshot.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

android_sdk="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Android/Sdk}}"
cmdline_tools_version="15859902"
cmdline_tools_sha256="4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583"
cmdline_tools_url="https://dl.google.com/android/repository/commandlinetools-linux-${cmdline_tools_version}_latest.zip"
profile_marker="# PolyglotYT Android toolchain"

step() {
  local name="$1"
  shift
  local start end
  start="$(date +%s)"
  echo "==> ${name}"
  "$@"
  end="$(date +%s)"
  echo "    (${name}: $((end - start))s)"
}

ensure_apt_packages() {
  local -a missing=()
  local pkg
  for pkg in "$@"; do
    if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then
      missing+=("$pkg")
    fi
  done
  if ((${#missing[@]} == 0)); then
    echo "apt packages already installed: $*"
    return 0
  fi
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
}

ensure_temurin_repo() {
  if [[ -f /etc/apt/sources.list.d/adoptium.list ]]; then
    echo "Adoptium apt source already present"
    return 0
  fi
  sudo mkdir -p /usr/share/keyrings
  curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
    | sudo gpg --dearmor --yes -o /usr/share/keyrings/adoptium.gpg
  echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb bookworm main" \
    | sudo tee /etc/apt/sources.list.d/adoptium.list >/dev/null
}

detect_java_home() {
  local candidate
  for candidate in \
    "${JAVA_HOME:-}" \
    /usr/lib/jvm/temurin-21-jdk-amd64 \
    /usr/lib/jvm/temurin-21-jdk*; do
    if [[ -n "$candidate" && -x "${candidate}/bin/java" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

write_local_properties() {
  local file="$repo_root/local.properties"
  if [[ -f "$file" ]]; then
    if grep -q '^sdk.dir=' "$file"; then
      if grep -qx "sdk.dir=${android_sdk}" "$file"; then
        echo "local.properties already points at ${android_sdk}"
        return 0
      fi
      sed -i "s|^sdk.dir=.*|sdk.dir=${android_sdk}|" "$file"
      echo "updated sdk.dir in local.properties"
      return 0
    fi
    printf '\nsdk.dir=%s\n' "$android_sdk" >>"$file"
    echo "appended sdk.dir to existing local.properties"
    return 0
  fi
  printf 'sdk.dir=%s\n' "$android_sdk" >"$file"
  echo "wrote ${file}"
}

ensure_profile() {
  local java_home="$1"
  local profile="$HOME/.bash_profile"
  touch "$profile"
  if grep -Fqx "$profile_marker" "$profile"; then
    echo "toolchain exports already in ~/.bash_profile"
    return 0
  fi
  cat >>"$profile" <<EOF

${profile_marker}
export JAVA_HOME="${java_home}"
export ANDROID_HOME="${android_sdk}"
export ANDROID_SDK_ROOT="${android_sdk}"
case ":\$PATH:" in
  *":\$JAVA_HOME/bin:"*) ;;
  *) export PATH="\$JAVA_HOME/bin:\$PATH" ;;
esac
case ":\$PATH:" in
  *":\$ANDROID_HOME/cmdline-tools/latest/bin:"*) ;;
  *) export PATH="\$ANDROID_HOME/cmdline-tools/latest/bin:\$ANDROID_HOME/platform-tools:\$PATH" ;;
esac
EOF
  echo "appended toolchain exports to ~/.bash_profile"
}

write_orb_guidance() {
  local amp_config_dir="$HOME/.config/amp"
  local guidance="$amp_config_dir/AGENTS.md"
  local marker="<!-- polyglotyt-orb-guidance -->"
  mkdir -p "$amp_config_dir"
  touch "$guidance"
  if grep -Fqx "$marker" "$guidance"; then
    echo "orb guidance already present"
    return 0
  fi
  cat >>"$guidance" <<'EOF'

<!-- polyglotyt-orb-guidance -->
# PolyglotYT in this orb

- This is an Android Xposed module (no standalone UI or emulator workflow).
- JDK 21 is required (`JAVA_HOME` from Temurin). Build with `./gradlew :app:assembleDebug`.
- The Android SDK lives at `$HOME/Android/Sdk` (`ANDROID_HOME` / `ANDROID_SDK_ROOT`).
- `local.properties` is generated by `.agents/setup` with `sdk.dir` only. Do not commit it. Release signing keys are optional and usually absent here; debug builds use the auto-generated debug keystore.
- There is no YouTube/Xposed runtime in the orb. Verify by compiling, not by launching the host app.
- Save visual artifacts under `.amp/in/artifacts/`.
EOF
  echo "appended orb guidance to ${guidance}"
}

accept_android_licenses() {
  mkdir -p "${android_sdk}/licenses"
  printf '24333f8a63b6825ea9c5514f83c2829b004d1fee\n' >"${android_sdk}/licenses/android-sdk-license"
  printf '84831b9409646161da1e9ea3b1f82d1abdc0ac71\n' >"${android_sdk}/licenses/android-sdk-preview-license"
}

install_cmdline_tools() {
  local dest="${android_sdk}/cmdline-tools/latest"
  if [[ -x "${dest}/bin/sdkmanager" ]]; then
    echo "Android command-line tools already installed"
    return 0
  fi
  local tmp zip
  tmp="$(mktemp -d)"
  zip="${tmp}/cmdline-tools.zip"
  curl -fsSL "$cmdline_tools_url" -o "$zip"
  echo "${cmdline_tools_sha256}  ${zip}" | sha256sum -c -
  unzip -q "$zip" -d "$tmp"
  mkdir -p "${android_sdk}/cmdline-tools"
  rm -rf "$dest"
  mv "${tmp}/cmdline-tools" "$dest"
  rm -rf "$tmp"
}

install_sdk_packages() {
  local sdkmanager="${android_sdk}/cmdline-tools/latest/bin/sdkmanager"
  local platform_dir="${android_sdk}/platforms"
  local -a missing=()

  if [[ -d "${platform_dir}/android-37" || -d "${platform_dir}/android-37.0" ]]; then
    echo "Android platform 37 already present"
  else
    if ! "$sdkmanager" --install "platforms;android-37"; then
      echo "platforms;android-37 unavailable, trying platforms;android-37.0"
      "$sdkmanager" --install "platforms;android-37.0"
    fi
  fi

  if [[ ! -d "${platform_dir}/android-37" && -d "${platform_dir}/android-37.0" ]]; then
    ln -sfn android-37.0 "${platform_dir}/android-37"
    echo "aliased platforms/android-37 -> android-37.0"
  fi

  if [[ ! -x "${android_sdk}/platform-tools/adb" ]]; then
    missing+=("platform-tools")
  else
    echo "platform-tools already installed"
  fi
  if [[ ! -x "${android_sdk}/build-tools/36.0.0/aapt" ]]; then
    missing+=("build-tools;36.0.0")
  else
    echo "build-tools;36.0.0 already installed"
  fi

  if ((${#missing[@]} > 0)); then
    "$sdkmanager" --install "${missing[@]}"
  fi
}

export_toolchain() {
  local java_home="$1"
  export JAVA_HOME="$java_home"
  export ANDROID_HOME="$android_sdk"
  export ANDROID_SDK_ROOT="$android_sdk"
  export PATH="${java_home}/bin:${android_sdk}/cmdline-tools/latest/bin:${android_sdk}/platform-tools:${PATH}"
}

warm_gradle() {
  chmod +x "${repo_root}/gradlew"
  ./gradlew --no-daemon :app:assembleDebug
}

step "install system packages" ensure_apt_packages ca-certificates curl unzip zip gnupg
step "add Adoptium apt source" ensure_temurin_repo
step "install Temurin JDK 21" ensure_apt_packages temurin-21-jdk

java_home="$(detect_java_home)"
export_toolchain "$java_home"
echo "JAVA_HOME=${java_home}"
echo "ANDROID_HOME=${android_sdk}"

step "install Android command-line tools" install_cmdline_tools
step "accept Android SDK licenses" accept_android_licenses
step "install Android SDK packages" install_sdk_packages
step "write local.properties" write_local_properties
step "persist toolchain in login profile" ensure_profile "$java_home"
step "write orb guidance" write_orb_guidance
step "warm Gradle wrapper and compile debug APK" warm_gradle

echo "setup complete"
